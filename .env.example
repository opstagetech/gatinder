# Copie para .env (local) e cadastre as mesmas no Cloudflare Pages:
# projeto → Settings → Variables and Secrets (tipo "Text")
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# (a antiga "anon public" também funciona, mas será desativada em 2027)
# NUNCA coloque aqui a "Secret key" (sb_secret_...)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
